# Process ID (update this after creating a process)
@processId = 1

# Report ID (update this after creating a report)
@reportId = 1



### Login - Investigator
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "bob@ipw.pt",
  "password": "12345"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginTokenInvestigator}}

{
  "role": "investigator"
}


### Create Report - Success (Investigator)
POST {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": "Veiculo com danos frontais compatíveis com embate em objeto fixo. Foram recolhidas fotografias do local e do veiculo."
}

### Create Report - Empty content (should fail)
POST {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": ""
}

### Create Report - Blank content (should fail)
POST {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": "   "
}



### Login - Triator
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "alice@ipw.pt",
  "password": "12345"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginTokenTriator}}

{
  "role": "triator"
}

### Create Report - Unauthorized (Triator cannot create)
POST {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenTriator}}

{
  "content": "Conteúdo do relatório"
}


### Login - Supervisor
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "carol@ipw.pt",
  "password": "12345"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginTokenSupervisor}}

{
  "role": "supervisor"
}


### Create Report - Unauthorized (Supervisor cannot create)
POST {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenSupervisor}}

{
  "content": "Conteúdo do relatório"
}

### Create Report - Invalid Process ID
POST {{baseUrl}}/process/9999/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": "Conteúdo do relatório válido"
}

### Login - Manager
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "david@ipw.pt",
  "password": "12345"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginTokenManager}}

{
  "role": "manager"
}


### Get Report by Process ID - Success (Investigator)
GET {{baseUrl}}/process/{{processId}}/report
Authorization: Bearer {{accessTokenInvestigator}}

### Get Report by Process ID - Success (Supervisor)
GET {{baseUrl}}/process/{{processId}}/report
Authorization: Bearer {{accessTokenSupervisor}}

### Get Report by Process ID - Success (Manager)
GET {{baseUrl}}/process/{{processId}}/report
Authorization: Bearer {{accessTokenManager}}

### Get Report by Process ID - Process Not Found
GET {{baseUrl}}/process/9999/report
Authorization: Bearer {{accessTokenInvestigator}}

### Get Report by Process ID - No Report Found
GET {{baseUrl}}/process/2/report
Authorization: Bearer {{accessTokenInvestigator}}


### Update Report - Success (Investigator who created it)
PUT {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": "Relatório atualizado com informações adicionais após inspeção no local."
}

### Update Report - Empty content (should fail)
PUT {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": ""
}

### Update Report - Unauthorized (Different investigator)
PUT {{baseUrl}}/process/{{processId}}/report
Content-Type: application/json
Authorization: Bearer {{accessTokenTriator}}

{
  "content": "Tentativa de atualização não autorizada"
}

### Update Report - Process Not Found
PUT {{baseUrl}}/process/9999/report
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}

{
  "content": "Conteúdo válido"
}


### Approve Report - Success (Supervisor on ongoing process)
POST {{baseUrl}}/process/{{processId}}/report/approve
Authorization: Bearer {{accessTokenSupervisor}}

### Approve Report - Success (Manager on waiting for approval manager)
POST {{baseUrl}}/process/{{processId}}/report/approve
Authorization: Bearer {{accessTokenManager}}

### Approve Report - Unauthorized (Investigator cannot approve)
POST {{baseUrl}}/process/{{processId}}/report/approve
Authorization: Bearer {{accessTokenInvestigator}}

### Approve Report - Unauthorized (Triator cannot approve)
POST {{baseUrl}}/process/{{processId}}/report/approve
Authorization: Bearer {{accessTokenTriator}}

### Approve Report - Invalid State
POST {{baseUrl}}/process/{{processId}}/report/approve
Authorization: Bearer {{accessTokenSupervisor}}

### Approve Report - Report Not Found
POST {{baseUrl}}/process/9999/report/approve
Authorization: Bearer {{accessTokenSupervisor}}


### Reject Report - Success (Supervisor on ongoing process)
POST {{baseUrl}}/process/{{processId}}/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenSupervisor}}


### Reject Report - Success (Manager on waiting for approval manager)
POST {{baseUrl}}/process/{{processId}}/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenManager}}

### Reject Report - Unauthorized (Investigator cannot reject)
POST {{baseUrl}}/process/{{processId}}/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenInvestigator}}


### Reject Report - Unauthorized (Triator cannot reject)
POST {{baseUrl}}/process/{{processId}}/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenTriator}}


### Reject Report - Invalid State
POST {{baseUrl}}/process/{{processId}}/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenSupervisor}}



### Reject Report - Report Not Found
POST {{baseUrl}}/process/9999/report/reject
Content-Type: application/json
Authorization: Bearer {{accessTokenSupervisor}}


