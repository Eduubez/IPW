@baseUrl = http://localhost:8080/api
@loginToken =
@accessToken =
@refreshToken =

### Create User
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Chico1",
  "email": "chico1@gmail.com",
  "password": "12345",
  "areaId": null,
  "roles": ["triator"]
}

### Login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "sarabuga@gmail.com",
  "password": "anime"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginToken}}

{
  "role": "admin"
}

### Refresh Access Token
POST {{baseUrl}}/users/refresh-token
Authorization: Bearer {{refreshToken}}

### Get Roles
GET {{baseUrl}}/users/roles?email=chico@gmail.com

### Get All Users
GET {{baseUrl}}/users?offset=0&limit=10
Authorization: Bearer {{accessToken}}

### Protected endpoint example
GET {{baseUrl}}/history/6
Authorization: Bearer {{accessToken}}
