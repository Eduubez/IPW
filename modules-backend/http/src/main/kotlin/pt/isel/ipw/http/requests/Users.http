@baseUrl = http://localhost:8080/api

@loginToken =
@accessToken =
@refreshToken =

### Login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "andreia@ipw.pt",
  "password": "12345"
}

### Select Role
POST {{baseUrl}}/users/auth/select-role
Content-Type: application/json
Authorization: Bearer {{loginToken}}

{
  "role": "admin"
}

### Create User
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Chico",
  "email": "chico@gmail.com",
  "password": "12345",
  "areaId": null,
  "roles": ["admin"]
}

### Refresh Access Token
POST {{baseUrl}}/users/refresh-token
Authorization: Bearer {{refreshToken}}

### Get Roles
GET {{baseUrl}}/users/roles?email=chico@gmail.com

### Get All Users
GET {{baseUrl}}/users?offset=0&limit=2&name=&areaId=1&isActive=true
Authorization: Bearer {{accessToken}}

### Protected endpoint example
GET {{baseUrl}}/process/1
Authorization: Bearer {{accessToken}}